{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "PayPathIQ API",
  "description": "Integrate source receivables with PayPathIQ through a deterministic record-level API.",
  "colors": {
    "primary": "#2563EB",
    "light": "#3B82F6",
    "dark": "#1D4ED8"
  },
  "navigation": {
    "products": [
      {
        "product": "PayPathIQ API",
        "href": "/"
      },
      {
        "product": "Docket Bench API",
        "href": "/docket-bench"
      }
    ]
  },
  "api": {
    "playground": {
      "display": "simple"
    },
    "url": "full",
    "examples": {
      "languages": ["curl"],
      "defaults": "required",
      "prefill": true,
      "autogenerate": true
    }
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "PayPathIQ",
      "href": "https://paypathiq.com"
    }
  },
  "contextual": {
    "options": ["copy", "download-spec"]
  }
}
